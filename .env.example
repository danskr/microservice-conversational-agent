# Required by the LLM used by the conversational agent.
OPENAI_API_KEY=replace-me

# Required for connecting LangSmith Studio to a local/dev Agent Server.
# You may disable tracing while still providing the key for Studio connectivity.
LANGSMITH_API_KEY=replace-me
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=order-fulfillment-conversational-agent

# Model is configurable without code changes.
OPENAI_MODEL=gpt-5-mini

# When running OUTSIDE Kubernetes, point this at the NodePort of the Order service.
ORDER_SERVICE_BASE_URL=http://192.168.253.10:30080

DIGEST_PATH=./digest/order-fulfillment-service-digest.yaml
MAX_AGENT_STEPS=8
REQUEST_TIMEOUT_SECONDS=20
MAX_API_RESULT_CHARS=12000
MAX_DIGEST_SNIPPETS=12
CONFIRM_CONDITIONAL_ACTIONS=false
